# Supabase（Vercel連携で自動設定）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# 公開URL（OAuthの戻り先 = ${APP_ORIGIN}/api/mf/callback）
APP_ORIGIN=https://studio.cpa-hara.com

# マネーフォワード クラウド API（アプリポータルで発行。Vercelでは Sensitive で登録）
MF_CLIENT_ID=
MF_CLIENT_SECRET=
# アプリポータルのクライアント認証方式：basic（CLIENT_SECRET_BASIC）または post（CLIENT_SECRET_POST）
MF_CLIENT_AUTH=basic
# 省略時：mfc/accounting/journal.read mfc/accounting/journal.write mfc/accounting/accounts.read
MF_SCOPES=
